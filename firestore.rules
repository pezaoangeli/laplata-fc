rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = usuário logado que tem um documento em /admins/{uid}
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cada usuário checa o próprio registro; admins leem a lista (para o backup).
    // Admins são criados manualmente pelo console.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Dados públicos: qualquer um lê, só admin altera
    match /jogadores/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /locais/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /adversarios/{id} { allow read: if true; allow write: if isAdmin(); }
    match /jogos/{id}       { allow read: if true; allow write: if isAdmin(); }
    // Financeiro: só admin. O público vê apenas o resumo sem nomes em /transparencia
    match /financeiro/{id}    { allow read, write: if isAdmin(); }
    match /mensalidades/{id}  { allow read, write: if isAdmin(); }
    match /lancamentos/{id}   { allow read, write: if isAdmin(); }
    match /transparencia/{id} { allow read: if true; allow write: if isAdmin(); }

    // Contador de visitas: qualquer visitante só consegue somar 1; só admin lê
    match /visitas/{dia} {
      allow read: if isAdmin();
      allow create: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['total', 'origens'])
        && request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'origens'])
        && request.resource.data.total == resource.data.total + 1;
    }

    // Premiações: só admin até a divulgação
    match /premiacoes/{id}  { allow read, write: if isAdmin(); }

    // Controle interno de adversários: SÓ admin lê e escreve
    match /adversariosPrivado/{id} { allow read, write: if isAdmin(); }
  }
}
